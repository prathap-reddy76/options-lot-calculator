# ==============================================================================
# OPTIONS LOT CALCULATOR — SERVER-SIDE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT SECURITY & ARCHITECTURE NOTICES:
# 1. Real credentials must remain strictly SERVER-SIDE.
# 2. NEVER expose broker API secrets with the `NEXT_PUBLIC_` prefix, as that bundle
#    exposes them to client-side browsers and third parties.
# 3. DO NOT commit `.env` or `.env.local` files containing real credentials to git.
# 4. Actual variable names, headers, and authentication flows (e.g. API Key/Secret,
#    OAuth 2.0, TOTP, Access Tokens) depend upon the selected broker provider.
# 5. Review provider-specific API permissions, IP whitelisting, rate limits, and
#    exchange market-data compliance agreements prior to production deployment.
# ==============================================================================

# Selected Market Data Provider Identifier:
# Use 'ANGEL_ONE' to enable Angel One SmartAPI integration. Leave blank for Manual Mode.
MARKET_DATA_PROVIDER=ANGEL_ONE

# ------------------------------------------------------------------------------
# ANGEL ONE SMARTAPI CREDENTIALS (Server-Side Only)
# ------------------------------------------------------------------------------
# 1. API Key generated from SmartAPI Developer Portal (https://smartapi.angelone.in)
ANGEL_ONE_API_KEY=your_smartapi_api_key_here

# 2. Angel One Client Code / User ID (e.g., A123456)
ANGEL_ONE_CLIENT_CODE=your_client_code_here

# 3. Client Account PIN / Password
ANGEL_ONE_PIN=your_account_pin_here

# 4. TOTP Secret Key (Base32 encoded secret provided during TOTP setup / QR code)
# Used to dynamically generate 6-digit Time-based One-Time Passwords on the server.
ANGEL_ONE_TOTP_SECRET=your_base32_totp_secret_here

# Optional: SmartAPI Base URL Override (Default: https://apiconnect.angelone.in)
ANGEL_ONE_BASE_URL=https://apiconnect.angelone.in

# Optional: SmartAPI WebSocket 2.0 URL Override (Default: wss://smartapisocket.angelone.in/smart-stream)
ANGEL_ONE_WS_URL=wss://smartapisocket.angelone.in/smart-stream

# Optional: Instrument Master URL Override
ANGEL_ONE_SCRIP_MASTER_URL=https://margincalculator.angelbroking.com/OpenAPI_File/files/OpenAPIScripMaster.json

# ------------------------------------------------------------------------------
# CACHE & TIMEOUT CONFIGURATION
# ------------------------------------------------------------------------------
# Maximum age before a cached quote is marked 'STALE' (Milliseconds)
MARKET_DATA_STALENESS_THRESHOLD_MS=60000

# Network Request Timeout (Milliseconds)
MARKET_DATA_TIMEOUT_MS=10000

# Instrument Master Cache TTL in Milliseconds (Default: 24 hours / 86,400,000 ms)
INSTRUMENT_MASTER_CACHE_TTL_MS=86400000
